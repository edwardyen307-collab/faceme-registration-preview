# FaceMe thin backend — same Windows PC as browser + Central (trial only).
# Created from this file on first start.bat if .env is missing. Existing .env is NEVER overwritten.
# Never commit .env. It may contain passwords — keep the laptop locked; restrict file ACL when offered.

# Listen (browser opens http://127.0.0.1:PORT/ — plain HTTP on loopback)
HOST=127.0.0.1
PORT=8443

# Privacy-notice statement version is defined in statement-version.json (NOT app version).
# Do NOT set FACEME_STATEMENT_VERSION here unless debugging; if set to a different value it is IGNORED
# and a startup warning is printed. Remove any old FACEME_STATEMENT_VERSION= line from your .env.
# FACEME_STATEMENT_VERSION=

# Real Central writes require BOTH = 1 after legal text is confirmed. Default safe: off.
FACEME_REAL_MODE=0
FACEME_STATEMENT_LEGAL_CONFIRMED=0

# Upstream FaceMe Security Central (server-side only; never sent to browser)
# Same-machine default. 127.0.0.1 is NOT guaranteed to work: Central may listen only on
# a LAN IP (e.g. 192.168.32.220) or require a hostname that matches the TLS certificate SAN.
# If TLS/hostname fails, set the URL Central actually serves (and prefer trusting the CA
# over FACEME_SKIP_TLS_VERIFY). Spec shapes still unverified against live Central.
FACEME_BASE_URL=https://127.0.0.1
FACEME_ACCOUNT=
FACEME_PASSWORD=

# Optional: skip TLS verify ONLY for the Central upstream Agent (not global Node).
# Risk: MITM. Default off — prefer installing/trusting the issuing CA.
# FACEME_SKIP_TLS_VERIFY=1

CONSENT_TTL_SECONDS=600
CONSENT_LOG_PATH=./runtime/consent.jsonl

# Same-origin local use needs no CORS. Pages cross-origin example (optional):
# CORS_ORIGINS=https://edwardyen307-collab.github.io
CORS_ORIGINS=

UPSTREAM_TIMEOUT_MS=15000
MAX_UPLOAD_BYTES=8388608
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# Group list/create body encoding (live Central rejects JSON with HTTP 415).
# Default auto: form → multipart → json; only 415 retries.
# Force one: multipart | form | json
# FACEME_GROUP_BODY_ENCODING=multipart
