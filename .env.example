# FaceMe thin backend (intranet trial only — do NOT expose to the public Internet)
# Copy to .env and fill locally. Never commit .env.

# Listen (prefer localhost or private NIC only)
HOST=127.0.0.1
PORT=8443

# Statement gate (must match frontend STATEMENT_VERSION)
FACEME_STATEMENT_VERSION=v2026-11-06b-draft
# Real Central writes require BOTH flags = 1 after legal text is confirmed
FACEME_REAL_MODE=0
FACEME_STATEMENT_LEGAL_CONFIRMED=0

# Upstream FaceMe Security Central (server-side only; never sent to browser)
# Spec provided by operator — not verified against a live Central from this environment.
FACEME_BASE_URL=https://192.168.32.220
FACEME_ACCOUNT=
FACEME_PASSWORD=

# Optional: skip TLS verify ONLY for the Central upstream Agent (not global).
# Risk: MITM on the path to Central. Default off.
# FACEME_SKIP_TLS_VERIFY=1

# Consent ticket TTL (seconds)
CONSENT_TTL_SECONDS=600

# Local append-only consent audit log (no photos/tokens/passwords). Ops owns retention.
CONSENT_LOG_PATH=./runtime/consent.jsonl

# CORS allowlist (comma-separated). No wildcard. Example for trusted Pages origin:
# CORS_ORIGINS=https://edwardyen307-collab.github.io
CORS_ORIGINS=

# Upstream timeouts / body limits
UPSTREAM_TIMEOUT_MS=15000
MAX_UPLOAD_BYTES=8388608

# Simple in-memory rate limit (per IP)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
